FROM golang:1.24-bookworm AS bridge-build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/agy-bridge/ ./cmd/agy-bridge/
RUN CGO_ENABLED=0 go build -trimpath -o /out/agy-bridge ./cmd/agy-bridge

FROM debian:bookworm-slim
# 固定已通过本机真实调用测试的官方 CLI 发行包，不在容器启动时下载。
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl openssl libstdc++6 libsecret-1-0 bubblewrap git && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL --retry 3 'https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.18-6386224290725888/linux-x64/cli_linux_x64.tar.gz' -o /tmp/agy.tgz \
    && echo 'ef379ec869719112f696e8c7cfddf776618712e58fc38e53df80801d6528abb4677782c7c8778f9c09c9123fa44c2c32675d228c06f2a8f7a8f4214e75f5bb26  /tmp/agy.tgz' | sha512sum -c - \
    && tar -xzf /tmp/agy.tgz -C /usr/local/bin antigravity \
    && ln -s antigravity /usr/local/bin/agy && rm /tmp/agy.tgz \
    && useradd --uid 10001 --create-home agy && chmod 0700 /home/agy \
    && install -d -m 0700 -o agy -g agy /home/agy/state
COPY --from=bridge-build /out/agy-bridge /usr/local/bin/agy-bridge
COPY deploy/agy-bridge/start.sh /usr/local/bin/start-agy-bridge
RUN sed -i 's/\r$//' /usr/local/bin/start-agy-bridge && chmod 0755 /usr/local/bin/start-agy-bridge
ENV HOME=/home/agy/state AGY_BRIDGE_STATE_DIR=/home/agy/state AGY_BRIDGE_TOKEN_FILE=/home/agy/state/bridge.token
USER 10001:10001
WORKDIR /tmp
RUN agy --version | grep -F '1.5.18'
ENTRYPOINT ["/usr/local/bin/start-agy-bridge"]
