# 复制为 .env 后填写真实值。docker-compose.yml 与 docker-compose.dev.yml 里
# 所有可变配置都用 ${VAR} 引用，本文件即这些变量的取值来源；.env 本身不入库。

# 数据库（必填）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=aiferry
MYSQL_USER=aiferry
MYSQL_PASSWORD=change-me
# 仅 docker-compose.db.yml 之类附带 MySQL 的本地编排需要，应用本身不读
MYSQL_ROOT_PASSWORD=change-root-me

# Redis（必填）
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# 主密钥（必填）：Base64 编码的 32 字节随机值，用于加密渠道密钥
AIFERRY_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key

# Casdoor 单点登录（必填）
CASDOOR_ENDPOINT=https://your-casdoor.example.com
CASDOOR_CLIENT_ID=change-me
CASDOOR_CLIENT_SECRET=change-me

# 可选：默认值见 internal/config/app.go
AIFERRY_ADMIN_ROLES=admin
TZ=Asia/Shanghai
CHANNEL_COOLDOWN_SECONDS=60
USAGE_RETENTION_DAYS=0

# 报文落盘与保留（目录位于 data 卷内）
PAYLOAD_LOG_ENABLED=true
PAYLOAD_LOG_DIR=/app/data/relay-payloads
# 两条限额必须同时生效：只限文件数兜不住体积（单条报文最大 1.2MB）
PAYLOAD_LOG_MAX_FILES=500
PAYLOAD_LOG_MAX_BYTES=536870912

# 宿主端口（默认 38517）
AIFERRY_PORT=38517

# 分布式集群（可选）。整段留空即为单机部署，行为与现在完全一致。
# 主节点：保持 AIFERRY_ROLE 不设或设为 master，并配置 AIFERRY_CLUSTER_SECRET。
# 子节点：设为 worker，只需数据库无关的本地数据卷；无需 MySQL / Redis / Casdoor。
# 密钥必须是至少 32 字节的随机串，主节点与所有子节点保持一致。
# 生成示例：openssl rand -hex 32
AIFERRY_ROLE=master
AIFERRY_CLUSTER_SECRET=
# 子节点专用：主节点访问地址（含协议与端口，容器内为 8080）
AIFERRY_MASTER_URL=http://aiferry:8080
# 子节点专用：节点名，主节点用它识别身份，必须唯一
AIFERRY_NODE_NAME=
# 子节点专用：内置 SQLite 与镜像数据的存放目录（需挂载为持久卷）
AIFERRY_DATA_DIR=/app/data
# 以下参数都有安全默认值，一般无需修改
# AIFERRY_SYNC_INTERVAL=60          配置同步周期（秒）
# AIFERRY_FLUSH_INTERVAL=30         用量回传周期（秒）
# AIFERRY_HEARTBEAT_INTERVAL=30     心跳周期（秒）
# AIFERRY_FINGERPRINT_INTERVAL=120  主节点配置漂移巡检周期（秒）
# AIFERRY_FLUSH_BATCH_SIZE=500      单次回传用量行数
# AIFERRY_OUTBOX_MAX_ROWS=50000     待回传行数告警阈值
# AIFERRY_BOOTSTRAP_REQUIRED=true   子节点启动时主节点不可达则拒绝启动
